# Supabase project values for browser-side SDK usage.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Direct Postgres URL. Supabase exposes this in Project Settings > Database.
# The app uses this with the pg package for portable SQL access.
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"
PGSSLMODE="require"

# Optional WhatsApp ordering target. Use country code, no plus sign.
NEXT_PUBLIC_WHATSAPP_NUMBER="60123456789"
