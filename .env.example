# Direct Postgres URL. This is the only database connection used by the app.
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"
PGSSLMODE="require"

# Supabase is used only as the image-object-storage provider. These values are
# server-only; never expose a Secret key through NEXT_PUBLIC_* variables.
SUPABASE_URL="https://your-project-ref.supabase.co"
# Use a current Supabase Secret key (sb_secret_...). The legacy
# SUPABASE_STORAGE_SERVICE_ROLE_KEY is accepted only for existing deployments.
SUPABASE_STORAGE_SECRET_KEY="sb_secret_your-secret-key"
SUPABASE_STORAGE_BUCKET="catalog-images"

# Seller details included in generated invoice and receipt snapshots.
BUSINESS_NAME="ITEMS"
BUSINESS_ADDRESS=""
BUSINESS_EMAIL=""
BUSINESS_PHONE=""
BUSINESS_TAX_ID=""

# Optional WhatsApp ordering target. Use country code, no plus sign.
NEXT_PUBLIC_WHATSAPP_NUMBER="60123456789"

# Canonical public URL. This must point at the deployed application and be
# reachable by social crawlers so Open Graph previews can load their images.
NEXT_PUBLIC_SITE_URL="https://itemsart.com"

# First-party analytics. Generate independent high-entropy values before deployment.
ANALYTICS_HASH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
CRON_SECRET="replace-with-a-separate-random-cron-secret"
